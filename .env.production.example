POSTGRES_DB=cleanops
POSTGRES_USER=cleanops
POSTGRES_PASSWORD=change-this-postgres-password

APP_PORT=8000
FRONTEND_URL=https://cleanjob.example.com
CORS_ORIGINS=["https://cleanjob.example.com"]
SECRET_KEY=replace-with-at-least-32-random-characters

S3_BUCKET=cleanops-photos
S3_REGION=ap-northeast-2
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=replace-with-object-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com

SOLAPI_API_KEY=replace-with-solapi-api-key
SOLAPI_API_SECRET=replace-with-solapi-api-secret
SOLAPI_SENDER_NUMBER=0212345678
SOLAPI_WEBHOOK_SECRET=replace-with-random-webhook-secret
SOLAPI_KAKAO_PF_ID=replace-with-kakao-pf-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_SCHEDULE_CONFIRMED=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_DAY_BEFORE=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_PARTNER_ASSIGNMENT=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_PHOTO_READY=replace-with-template-id
SOLAPI_ALIMTALK_FALLBACK_SMS=true
