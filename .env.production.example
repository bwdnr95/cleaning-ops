# ============================================================================
# Production environment template — Cleaning Ops Control Center
# ----------------------------------------------------------------------------
# 운영 배포(Railway 백엔드 + Vercel 프론트 + Cloudflare R2 사진 스토리지) 기준.
# 실 배포 전 모든 `replace-with-...` 값을 교체하고, .env.production 파일은
# git ignored 이므로 버전 관리에 들어가지 않게 주의.
# ============================================================================

# ───── 기본 환경 ──────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_PORT=8000
FRONTEND_URL=https://app.example.kr
CORS_ORIGINS=["https://app.example.kr"]
# 클린잡 카카오톡 비즈니스 채널 URL. 미설정 시 상담 버튼은 숨김.
KAKAO_CHANNEL_URL=
# SECRET_KEY 는 32자 이상 랜덤. 예: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-at-least-32-random-characters

# ───── PostgreSQL (Railway 통합 시 DATABASE_URL 자동 주입) ────────────────
# docker-compose.production.yml 단독 운용 시 아래 값을 채워서 사용.
POSTGRES_DB=cleanops
POSTGRES_USER=cleanops
POSTGRES_PASSWORD=change-this-postgres-password
# DATABASE_URL=postgresql+psycopg://cleanops:${POSTGRES_PASSWORD}@db:5432/cleanops

# ───── Object Storage (Cloudflare R2 권장 — S3 호환) ─────────────────────
# Cloudflare R2 셋업:
#   1. Dashboard → R2 → Create bucket: cleanops-photos
#   2. R2 API Tokens → Create API Token → Object Read & Write 권한
#   3. Bucket → Settings → Public Access → Custom domain 연결: photos.example.kr
#   4. CORS Policy 에 https://app.example.kr 허용
STORAGE_PROVIDER=s3
S3_BUCKET=cleanops-photos
# R2 는 region 'auto', AWS 는 ap-northeast-2 등
S3_REGION=auto
# Cloudflare R2 endpoint 형식: https://<account_id>.r2.cloudflarestorage.com
# AWS S3 사용 시에는 빈 값 (boto3 기본값 사용)
S3_ENDPOINT_URL=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-r2-or-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-r2-or-s3-secret-key
# 고객 화면이 사진을 로드할 공개 도메인 (R2 custom domain 또는 CloudFront)
S3_PUBLIC_BASE_URL=https://photos.example.kr

# ───── 메시지 (SOL-API: 카카오 알림톡 + SMS 폴백) ─────────────────────────
# 카카오 심사 미통과 상태에서는 MESSAGE_PROVIDER=mock 으로 운영 시작 가능.
# 통과 후 solapi 로 전환하고 KAKAO_TEMPLATE_* 4종 ID 채움.
MESSAGE_PROVIDER=solapi
SOLAPI_API_KEY=replace-with-solapi-api-key
SOLAPI_API_SECRET=replace-with-solapi-api-secret
# 발신번호는 KISA 사전등록 + SOL-API 콘솔 인증 필수
SOLAPI_SENDER_NUMBER=0212345678
# Webhook 본문 HMAC 검증용 — 32자 이상 랜덤. 빈 값이면 webhook 거부
SOLAPI_WEBHOOK_SECRET=replace-with-random-webhook-secret-32chars
SOLAPI_KAKAO_PF_ID=replace-with-kakao-pf-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_SCHEDULE_CONFIRMED=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_DAY_BEFORE=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_PARTNER_ASSIGNMENT=replace-with-template-id
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_PHOTO_READY=replace-with-template-id
# 알림톡 발송 실패 시 SMS 폴백. 단가 차이 있으니 운영팀 판단 후 결정
SOLAPI_ALIMTALK_FALLBACK_SMS=true

# ───── Sentry (백엔드) ──────────────────────────────────────────────────
# https://sentry.io → Project (FastAPI) 생성 → DSN 복사
SENTRY_DSN=https://replace-with-sentry-key@oXXXXXX.ingest.sentry.io/XXXXXX
SENTRY_ENVIRONMENT=production
# 배포 자동화 시 git SHA 주입 권장 (Railway: ${{RAILWAY_GIT_COMMIT_SHA}})
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
